<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>com.saferoute</groupId>
    <artifactId>safe-route</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>safe-route</name>
    <description>상황 맞춤 보행 경로 도우미</description>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <!-- 코드 품질 도구 (2026-11-24). 지금은 경고만 내고 빌드는 막지 않는다 -->
        <checkstyle.failOnViolation>false</checkstyle.failOnViolation>
        <spotbugs.failOnError>false</spotbugs.failOnError>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- 공간 데이터를 한꺼번에 넣고 SQL로 꺼내기 쉽도록 JPA 대신 JDBC로 시작 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>

        <!-- 경로 탐색 (A*). 길마다 비용을 요청 때 바꿔 끼우기 쉽다 -->
        <dependency>
            <groupId>org.jgrapht</groupId>
            <artifactId>jgrapht-core</artifactId>
            <version>1.5.2</version>
        </dependency>

        <!-- 서버 상태 확인 주소(/actuator/health). 배포 스크립트가 새 서버가 떴는지 이 주소로 본다 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 느린 쿼리 로그: DataSource를 감싸 SQL마다 걸린 시간을 잰다 (common/SlowQueryLog) -->
        <dependency>
            <groupId>net.ttddyy</groupId>
            <artifactId>datasource-proxy</artifactId>
            <version>1.11.1</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- 일몰·일출 계산 (밤 판단, FR-02). 인터넷 호출 없이 위치와 날짜로 계산 -->
        <dependency>
            <groupId>org.shredzone.commons</groupId>
            <artifactId>commons-suncalc</artifactId>
            <version>3.11</version>
        </dependency>

        <!-- 신고 사진 종류 판단 (036 photo_label). A파트 모델(model.onnx)을 서버 CPU에서 돌린다. 사진은 밖으로 안 나감 -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.22.0</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!-- 포매터 Spotless: 코드 모양 맞추기. 손으로 돌린다: ./mvnw spotless:apply
                 develop과 비교해 바뀐 파일만 고친다(ratchetFrom). 한꺼번에 바꾸면 열린 PR과 충돌하기 때문.
                 줄바꿈까지 바꾸는 큰 포매터는 쓰지 않고 import 순서·안 쓰는 import·줄 끝 공백만 맞춘다 -->
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>2.46.1</version>
                <configuration>
                    <ratchetFrom>origin/develop</ratchetFrom>
                    <java>
                        <importOrder>
                            <order>java|javax,,org,com</order>
                        </importOrder>
                        <removeUnusedImports/>
                        <trimTrailingWhitespace/>
                        <endWithNewline/>
                    </java>
                </configuration>
            </plugin>

            <!-- 린터 Checkstyle: 실수하기 쉬운 코드에 경고. 규칙은 config/checkstyle.xml.
                 ./mvnw verify 때 같이 돌고, 경고만 찍는다 -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <version>3.6.0</version>
                <dependencies>
                    <dependency>
                        <groupId>com.puppycrawl.tools</groupId>
                        <artifactId>checkstyle</artifactId>
                        <version>10.26.1</version>
                    </dependency>
                </dependencies>
                <configuration>
                    <configLocation>config/checkstyle.xml</configLocation>
                    <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    <consoleOutput>true</consoleOutput>
                    <violationSeverity>warning</violationSeverity>
                </configuration>
                <executions>
                    <execution>
                        <id>checkstyle</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- 정적 분석 SpotBugs: 실행하지 않고 읽어서 버그가 날 만한 구조를 찾는다.
                 ./mvnw verify 때 같이 돌고 경고만 낸다. 목록은 target/spotbugsXml.xml,
                 보기 좋게 보려면 ./mvnw spotbugs:gui. 빼는 규칙은 config/spotbugs-exclude.xml -->
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>4.9.3.0</version>
                <configuration>
                    <excludeFilterFile>config/spotbugs-exclude.xml</excludeFilterFile>
                </configuration>
                <executions>
                    <execution>
                        <id>spotbugs</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
