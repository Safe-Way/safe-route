# 이 파일을 복사해 .env를 만들고 값을 채운다: cp .env.example .env
# 키와 비밀번호는 팀 채팅 등 git 밖에서 받는다. .env는 절대 커밋하지 않는다.

# 공공데이터 인증키 (Decoding 키를 = 뒤에 붙여 넣고 저장)
DATA_GO_KR_KEY=

# 재난안전데이터 공유플랫폼 (safetydata.go.kr). 데이터마다 키가 따로 있음. 하루 1000번, 2027-10-28 만료
# 주소: https://www.safetydata.go.kr/V2/api/DSSP-IF-xxxxx?serviceKey=키
SAFETYDATA_STREETLIGHT_KEY=
SAFETYDATA_POLICE_KEY=
SAFETYDATA_SECURITYLIGHT_KEY=
SAFETYDATA_COLDSHELTER_KEY=

# 학교 MySQL (지금 사용 중). 학교 네트워크 안에서만 접속됨
DB_URL=jdbc:mysql://s4.java21.net:13306/cf_u34_d3?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=cf_u34_d3
DB_PASSWORD=

# 로컬 MySQL 8.4 (학교 밖에서 개발할 때 위 세 줄을 주석 처리하고 이 세 줄을 풀어서 사용)
# DB_URL=jdbc:mysql://localhost:3306/safe_route?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
# DB_USERNAME=safe_route
# DB_PASSWORD=

SAFEMAP_KEY=

# 카카오 REST API (주소·장소 검색)
KAKAO_REST_KEY=
